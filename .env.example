# =============================================================================
# ATS — example configuration.  Copy to `.env` and edit.  NEVER commit `.env`.
# Every setting below maps 1:1 to a field on `app.config.Settings`; the test
# `test_env_example_covers_settings` (SEC-001) fails if they drift apart.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=ATS
# development | test | production
ENVIRONMENT=development
VERSION=0.1.0
# Injected at image build time; leave as-is for local runs.
GIT_COMMIT=unknown

# --- Mode and providers ------------------------------------------------------
# PAPER | SUPERVISED | LIVE.  Anything unset or unrecognised resolves to PAPER.
TRADING_MODE=PAPER
# paper | groww.  LIVE/SUPERVISED with `paper` is a fatal configuration error.
BROKER_PROVIDER=paper
# claude | openai | fallback.  `claude` without ANTHROPIC_API_KEY degrades to fallback.
LLM_PROVIDER=claude

# --- API ---------------------------------------------------------------------
# Binding beyond localhost requires TLS_ENABLED=true (SEC-009).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
TLS_ENABLED=false

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ats:ats@localhost:5432/ats
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=60

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | plain
LOG_FORMAT=json
LOG_DIR=logs
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10

# --- Capital and risk limits -------------------------------------------------
# REQUIRED before trading.  Deliberately has no default — set your real capital.
STARTING_CAPITAL=
# Percent of capital risked on a single trade.
PER_TRADE_RISK_PCT=0.5
# Session loss that blocks all new entries.
DAILY_LOSS_LIMIT_PCT=2
# Peak-to-trough drawdown that disarms the system and requires manual re-arming.
MAX_DRAWDOWN_PCT=10
# Gross notional exposure cap, as a multiple of capital.
MAX_GROSS_EXPOSURE_MULTIPLE=3
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=10
MIN_REWARD_RISK_RATIO=1.5
# Fraction of available margin held back as a buffer.
MARGIN_BUFFER_PCT=20
# Maximum acceptable estimated slippage on entry.
MAX_SLIPPAGE_PCT=0.3
# Unbounded-risk structures.  Keep false unless you fully accept the risk.
ALLOW_NAKED_SHORT_OPTIONS=false
# Overnight/positional trading.  Architecturally supported, off by default.
ALLOW_POSITIONAL=false
LOSS_COOLOFF_MINUTES=30

# --- Session windows (IST) ---------------------------------------------------
ENTRY_BLACKOUT_OPEN_MINUTES=5
ENTRY_BLACKOUT_CLOSE_MINUTES=20
# Own square-off, ahead of the broker's auto square-off.
INTRADAY_SQUAREOFF_TIME=15:10
FNO_EXPIRY_ENTRY_CUTOFF_TIME=14:30

# --- Market data -------------------------------------------------------------
TICK_STALENESS_SECONDS=15
GREEKS_STALENESS_SECONDS=60
TICK_PERSISTENCE_ENABLED=true
TICK_SAMPLE_INTERVAL_SECONDS=5
# Groww caps websocket subscriptions at 1000.
FEED_SUBSCRIPTION_BUDGET=1000

# --- Groww broker ------------------------------------------------------------
GROWW_BASE_URL=https://api.groww.in/v1
GROWW_API_VERSION=1.0
# Flow A: API key + secret (daily approval, token endpoint capped at 150/24h).
GROWW_API_KEY=
GROWW_API_SECRET=
# Flow B (preferred): TOTP token + TOTP secret, no token expiry.
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
GROWW_TIMEOUT_SECONDS=10
GROWW_MAX_RETRIES=3
GROWW_DAILY_TOKEN_BUDGET=150

# --- Compliance (SEBI retail algo framework) ---------------------------------
# Exchange/broker-issued algo identifier.  Required before LIVE.
COMPLIANCE_ALGO_ID=
COMPLIANCE_ALGO_REGISTERED=false
# Kept well below the 10 orders/second retail threshold.
COMPLIANCE_MAX_ORDERS_PER_SECOND=5

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_DAILY_COST_CAP_USD=5
LLM_MAX_REPAIR_ATTEMPTS=1
LLM_REFERENCE_REVIEW_ENABLED=false
LLM_REFERENCE_TASK=review
LLM_DAILY_TOKEN_CAP=2000000
# Required owner tariff for paid reviews; blank means unavailable, never zero.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_TARIFF_MODEL=
# Explicit timezone-aware ISO timestamp; see docs/CLAUDE_ADVISORY.md.
LLM_TARIFF_VALID_UNTIL=
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# --- News --------------------------------------------------------------------
NEWS_ENABLED=true
NEWS_POLLING_ENABLED=false
NEWS_POLL_BATCH_SIZE=5
NEWS_RESEARCH_ENABLED=false
NEWS_RESEARCH_BATCH_SIZE=2
NEWS_RESEARCH_MAX_OWNER_RETRIES=1
# Non-critical by default: a news outage degrades, it does not disable trading.
NEWS_CRITICAL=false
NEWS_POLL_INTERVAL_SECONDS=300
NEWS_MAX_AGE_HOURS=24

# --- Notifications -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
NOTIFICATION_ENABLED=false
NOTIFICATION_ROUTES={"telegram":["CRITICAL"],"email":["CRITICAL"]}
NOTIFICATION_QUIET_START=
NOTIFICATION_QUIET_END=
NOTIFICATION_QUEUE_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_RETRY_DELAY_SECONDS=1
NOTIFICATION_WINDOW_SECONDS=60
NOTIFICATION_MAX_EVENTS_PER_SEVERITY=100
NOTIFICATION_MAX_CONDITIONS=1000

# --- Dashboard security ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_HOURS=24
PAPER_WORKER_ENABLED=false
INSTRUMENT_REFRESH_ENABLED=false
HISTORICAL_PLANS_FILE=
PAPER_CYCLE_SECONDS=5
PAPER_ENTRY_MAX_AGE_SECONDS=300
PAPER_BROKER_REJECTION_LIMIT=3
DASHBOARD_USERNAME=owner
# Argon2id hash; generate with `python -m app.security.hash_password`.
DASHBOARD_PASSWORD_HASH=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Monitoring --------------------------------------------------------------
HEALTHCHECK_INTERVAL_SECONDS=60
CLOCK_MAX_SKEW_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=30

# --- Validation gates before a strategy may trade LIVE -----------------------
MIN_PAPER_SESSIONS_FOR_LIVE=20
MIN_PAPER_TRADES_FOR_LIVE=30
MIN_OOS_TRADES_FOR_LIVE=30
MIN_BACKTEST_DAYS=60
